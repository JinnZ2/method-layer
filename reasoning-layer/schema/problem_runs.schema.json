{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reasoning-layer/problem_runs.schema.json",
  "title": "reasoning-layer problem runs",
  "description": "Registry of problem runs. Every card must carry a check_record entry for every run listed here.",
  "type": "object",
  "required": [
    "runs"
  ],
  "additionalProperties": false,
  "properties": {
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "problem",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "problem": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  }
}
